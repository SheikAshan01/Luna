# ==================================================
# LUNA AI - Environment Configuration
# ==================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
SECRET_KEY=luna-super-secure-secret-key-change-in-production-32bytesmin
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings
# Options: "hybrid", "online", "offline"
AI_MODE=hybrid
DEFAULT_PROVIDER=openai

# OpenAI Cloud Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=30

# Voice Settings
VOICE_LANGUAGE=ta-IN
VOICE_SPEECH_PROVIDER=edge-tts
TAMIL_TTS_VOICE=ta-IN-PallaviNeural
ENGLISH_TTS_VOICE=en-US-JennyNeural
TTS_SPEED=1.0
WAKE_WORD_SENSITIVITY=0.6

# ElevenLabs Voice (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Storage
DATABASE_URL=sqlite:///./luna.db

# Windows Actions Allowlist
# Comma-separated application commands/paths
ALLOWED_APPLICATIONS=code,notepad,calc,explorer,chrome,msedge,wt,powershell
ALLOWED_WORKSPACES=d:\luna,c:\projects
